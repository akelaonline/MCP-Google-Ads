# GTM OAuth identity dedicated to Measurement Ops.
GTM_GOOGLE_CLIENT_ID=
GTM_GOOGLE_CLIENT_SECRET=
GTM_GOOGLE_REFRESH_TOKEN=

# Capability gates. Safe defaults are intentionally false.
# Quick preview needs tagmanager.edit.containerversions even though it does not publish.
GTM_ENABLE_PREVIEW=false
# GTM_ENABLE_WRITES allows workspace/entity mutations but does NOT allow publish.
GTM_ENABLE_WRITES=false
# GTM_ENABLE_PUBLISH adds the publish OAuth scope and still requires confirm=true per call.
GTM_ENABLE_PUBLISH=false

# Site/GA4/Ads credentials live in provider credential stores, never in the Site Registry.

# Durable non-secret registry/workflow state. Optional; default is ~/.mkt-measurement-ops/measurement_ops.db
# MEASUREMENT_OPS_DB=/absolute/path/measurement_ops.db

# Dedicated GA4 read-only OAuth identity for Data API verification.
GA4_GOOGLE_CLIENT_ID=
GA4_GOOGLE_CLIENT_SECRET=
GA4_GOOGLE_REFRESH_TOKEN=
