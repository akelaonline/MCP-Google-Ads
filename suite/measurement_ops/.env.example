# GTM OAuth identity dedicated to Measurement Ops.
# Start with a token authorized only for tagmanager.readonly.
GTM_GOOGLE_CLIENT_ID=
GTM_GOOGLE_CLIENT_SECRET=
GTM_GOOGLE_REFRESH_TOKEN=

# No GTM write/publish credentials are required by v0.1.
# Site/GA4/Ads credentials will live in their provider credential stores,
# never in the Site Registry.
