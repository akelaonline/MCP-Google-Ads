# --- Google Ads API credentials ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Only needed if you access client accounts through an MCC (manager) account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Customer isolation ---
# Optional comma-separated deployment allowlist. When set, reads AND writes for
# any other customer ID are blocked centrally before the account is contacted.
# Example: 123-456-7890,987-654-3210
GOOGLE_ADS_MCP_ALLOWED_CUSTOMER_IDS=

# Recommended for one-MCP-per-client / strict multi-tenant deployments.
# If true, startup fails unless the allowlist above has at least one customer ID.
GOOGLE_ADS_MCP_REQUIRE_CUSTOMER_ALLOWLIST=false

# --- Write approval policy ---
# Global auto-approve applies only to STANDARD-risk writes.
# Leave false for accounts with real spend unless you have a controlled workflow.
GOOGLE_ADS_MCP_AUTO_APPROVE=false

# High-risk auto-approve requires separate explicit opt-ins. Defaults are false
# even when GOOGLE_ADS_MCP_AUTO_APPROVE=true.
# SPEND: budgets, bidding, live targeting/goal changes, recommendation apply, etc.
GOOGLE_ADS_MCP_AUTO_APPROVE_SPEND=false
# DESTRUCTIVE: removes, terminal statuses, ending experiments, unlinking access.
GOOGLE_ADS_MCP_AUTO_APPROVE_DESTRUCTIVE=false
# SENSITIVE: first-party data, billing, identity, MCC/user/product-link changes.
GOOGLE_ADS_MCP_AUTO_APPROVE_SENSITIVE=false

# How long a proposed (unconfirmed) action stays valid, in minutes.
GOOGLE_ADS_MCP_PENDING_TTL_MINUTES=30

# Where the audit trail and durable pending queue (SQLite) are written.
# Leave blank to use ~/.google_ads_mcp/audit.db
#
# IMPORTANT: one running MCP process should own one audit/pending DB. The server
# serializes confirm/cancel calls inside a process, but the SQLite pending schema
# is not a distributed claim/lease system. Do not point multiple simultaneous MCP
# processes/workers at the same audit.db.
GOOGLE_ADS_MCP_AUDIT_DB=

# Optional Fernet key used to encrypt the original MCP arguments needed to replay
# a pending action after process/container restart. Recommended for containers and
# other deployments where the generated sibling key file may not persist.
# Generate once and keep it stable, for example:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# If blank, the MCP creates <audit-db>.pending.key with mode 0600. Persist BOTH
# the SQLite DB and that key file across restarts, or pending actions from the old
# process cannot be decrypted (they will fail closed; no Ads mutation is executed).
GOOGLE_ADS_MCP_PENDING_ENCRYPTION_KEY=

# "stdio" is the safe/default transport for Claude Desktop / Claude Code.
# HTTP exposes read, write AND confirmation tools. It is blocked by default
# because this MCP does not ship a built-in remote auth provider.
GOOGLE_ADS_MCP_TRANSPORT=stdio
GOOGLE_ADS_MCP_HTTP_PORT=8080

# Only set true when HTTP is placed behind your own authenticated/restricted
# reverse proxy or equivalent access-control layer. Never expose it publicly.
GOOGLE_ADS_MCP_ALLOW_INSECURE_HTTP=false
